! Elmer FEM Configuration: Gabbia Sferica con Doppio Macro-Gruppo Ortogonale a 90°
! Variante Avanzata: Mantello Metamateriale Chirale Asimmetrico (+45° / +15° / -22.5°)
!                    con Impulsi Chirped Non-Lineari di 3ª Armonica (Chiral Diode & WPT)
!
! Topologia e Parametri di Progetto:
!   - Gruppo 1 (Equatoriale Z=0, R_c1 = 37 mm, asse Z): 24 solenoidi distribuiti a Delta_theta = 15°
!   - Gruppo 2 (Meridiano X=0, R_c2 = 31 mm, asse X): 24 solenoidi in quadratura temporale +90°
!   - Mantello Metamateriale a Gradiente Asimmetrico (mu_r = 1000):
!       * Strato 1 Interno (47-48 mm):  theta = +45.0°, s_tp = +1.00 * s_base (Conversione CP ultra-spinta)
!       * Strato 2 Intermedio (48-49 mm): theta = +15.0°, s_tp = +0.50 * s_base (Raccordo adiabatico di fase)
!       * Strato 3 Esterno (49-50 mm):  theta = -22.5°, s_tp = -0.71 * s_base (Cancellazione riflessione e schermatura)
!   - Nucleo centrale sferico in PEEK amagnetico (R = 12 mm, mu_r = 1.0, sigma = 0.0 S/m)
!   - Legge di Pilotaggio: Pisano mod 9 con Iniezione Armonica Chirped (beta_3 = 0.15, psi_3 = pi/6)
!   - Regime Operativo: f = 100 Hz, J0 = 2.0e5 A/m^2, dt = 0.25 ms, 64 timestep (16.0 ms)

$ function group1_z_chirped_pulse_current(tx) {\
  x = tx(0); y = tx(1); z = tx(2); t = tx(3);\
  th = atan2(y, x);\
  if (th < 0.0) { th = th + 6.283185307179586; } else { th = th; };\
  d_th = 0.2617993877991494;\
  k = floor((th + 0.1308996938995747) / d_th);\
  if (k >= 24) { k = 0; } else { k = k; };\
  p = zeros(24, 1);\
  p(0)  = 6.283185; p(1)  = 0.698132; p(2)  = 0.698132; p(3)  = 1.396263;\
  p(4)  = 2.094395; p(5)  = 3.490659; p(6)  = 5.585054; p(7)  = 2.792527;\
  p(8)  = 2.094395; p(9)  = 4.886922; p(10) = 0.698132; p(11) = 5.585054;\
  p(12) = 6.283185; p(13) = 5.585054; p(14) = 5.585054; p(15) = 4.886922;\
  p(16) = 4.188790; p(17) = 2.792527; p(18) = 0.698132; p(19) = 3.490659;\
  p(20) = 4.188790; p(21) = 1.396263; p(22) = 5.585054; p(23) = 0.698132;\
  phi = p(k);\
  w = 628.3185307179586;\
  j0 = 2.0e+05;\
  fund = sin(w * t + phi);\
  h3   = 0.15 * sin(3.0 * (w * t + phi) + 0.5235987755982988);\
  res = j0 * (fund + h3);\
  _group1_z_chirped_pulse_current = res;\
}

$ function group2_x_chirped_pulse_current(tx) {\
  x = tx(0); y = tx(1); z = tx(2); t = tx(3);\
  psi = atan2(z, y);\
  if (psi < 0.0) { psi = psi + 6.283185307179586; } else { psi = psi; };\
  d_psi = 0.2617993877991494;\
  k = floor((psi + 0.1308996938995747) / d_psi);\
  if (k >= 24) { k = 0; } else { k = k; };\
  p = zeros(24, 1);\
  p(0)  = 6.283185; p(1)  = 0.698132; p(2)  = 0.698132; p(3)  = 1.396263;\
  p(4)  = 2.094395; p(5)  = 3.490659; p(6)  = 5.585054; p(7)  = 2.792527;\
  p(8)  = 2.094395; p(9)  = 4.886922; p(10) = 0.698132; p(11) = 5.585054;\
  p(12) = 6.283185; p(13) = 5.585054; p(14) = 5.585054; p(15) = 4.886922;\
  p(16) = 4.188790; p(17) = 2.792527; p(18) = 0.698132; p(19) = 3.490659;\
  p(20) = 4.188790; p(21) = 1.396263; p(22) = 5.585054; p(23) = 0.698132;\
  phi = p(k);\
  w = 628.3185307179586;\
  j0 = 2.0e+05;\
  fund = cos(w * t + phi);\
  h3   = 0.15 * cos(3.0 * (w * t + phi) + 0.5235987755982988);\
  res = j0 * (fund + h3);\
  _group2_x_chirped_pulse_current = res;\
}

$ function sigma_asymmetric_chiral_mantle(tx) {\
  x = tx(0); y = tx(1); z = tx(2);\
  r = sqrt(x*x + y*y + z*z);\
  if (r < 1.0e-5) { r = 1.0e-5; } else { r = r; };\
  rho = sqrt(x*x + y*y);\
  if (rho < 1.0e-5) { rho = 1.0e-5; } else { rho = rho; };\
  xi = (r - 0.047) / 0.003;\
  if (xi < 0.0) { xi = 0.0; } else { if (xi > 1.0) { xi = 1.0; } else { xi = xi; }; };\
  s_base = 3.031089e6;\
  if (xi <= 0.3333333333333333) {\
    s_tp = 1.00 * s_base;\
  } else {\
    if (xi <= 0.6666666666666666) {\
      s_tp = 0.50 * s_base;\
    } else {\
      s_tp = -0.70710678 * s_base;\
    };\
  };\
  s0 = 1.75e6;\
  s_phi = 1.22e7;\
  ds = s_phi - s0;\
  px = -y / rho; py = x / rho;\
  tx_c = (z / r) * (x / rho);\
  ty_c = (z / r) * (y / rho);\
  tz_c = -rho / r;\
  a = zeros(3,3);\
  a(0,0) = s0 + ds * px*px + 2.0 * s_tp * tx_c * px;\
  a(1,1) = s0 + ds * py*py + 2.0 * s_tp * ty_c * py;\
  a(2,2) = s0;\
  c12 = ds * px*py + s_tp * (tx_c * py + px * ty_c);\
  a(0,1) = c12; a(1,0) = c12;\
  c13 = s_tp * px * tz_c;\
  a(0,2) = c13; a(2,0) = c13;\
  c23 = s_tp * py * tz_c;\
  a(1,2) = c23; a(2,1) = c23;\
  _sigma_asymmetric_chiral_mantle = a;\
}

Header
  CHECK KEYWORDS Warn
  Mesh DB "mesh" "macchina_chiral_diode_48"
  Include Path ""
  Results Directory "results"
End

Simulation
  Max Output Level = 3
  Coordinate System = Cartesian 3D
  Coordinate Mapping(3) = 1 2 3
  Simulation Type = Transient
  Steady State Max Iterations = 1
  Output Intervals(1) = 1
  Timestep Intervals(1) = 64
  Timestep Sizes(1) = 0.00025
End

Constants
  Permittivity of Vacuum = 8.8542e-12
  Permeability of Vacuum = 1.2566370614e-6
End

Equation 1
  Name = "Coupled Electromagnetics"
  Active Solvers(3) = 1 2 3
End

Solver 1
  Equation = "MGDynamics"
  Variable = "AV"
  Procedure = "MagnetoDynamics" "WhitneyAVSolver"
  Fix Input Current Density = Logical False
  Use Piola Transform = Logical False
  Linear System Solver = "Direct"
  Linear System Direct Method = Umfpack
End

Solver 2
  Equation = "MGDynamicsCalc"
  Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"
  Potential Variable = String "AV"
  Calculate Elemental Fields = Logical True
  Calculate Nodal Fields = Logical True
  Calculate Magnetic Flux Density = Logical True
  Calculate Magnetic Vector Potential = Logical True
  Calculate Current Density = Logical True
  Calculate Electric Field = Logical True
  Calculate Joule Heating = Logical True
  Calculate JxB = Logical True
  Linear System Solver = "Direct"
  Linear System Direct Method = Umfpack
End

Solver 3
  Exec Solver = After Timestep
  Procedure = "ResultOutputSolve" "ResultOutputSolver"
  Output File Name = "macchina_chiral_diode_out"
  Output Format = "vtu"
  Vtu Format = Logical True
  Save Geometry Ids = Logical True
  Discontinuous Bodies = Logical True
End

! Material 1: Mantello Sferico Metamateriale a Gradiente Asimmetrico Ferromagnetico
Material 1
  Name = "AsymmetricChiralMetamaterialMantle"
  Relative Permeability = 1000.0
  Electric Conductivity(3,3) = Variable Coordinate 1, Coordinate 2, Coordinate 3
    Real MATC "sigma_asymmetric_chiral_mantle(tx)"
End

! Material 2: Bobine Rame Cu-ETP (Gruppo 1 e Gruppo 2)
Material 2
  Name = "CopperCoils"
  Relative Permeability = 1.0
  Electric Conductivity = 5.8e7
End

! Material 3: Nucleo Centrale Sferico in PEEK
Material 3
  Name = "AmagneticPEEKCore"
  Relative Permeability = 1.0
  Electric Conductivity = 0.0
End

! Material 4: Aria (Cavità Interna ed Esterno)
Material 4
  Name = "Air"
  Relative Permeability = 1.0
  Electric Conductivity = 0.0
End

! Body Force 1: Gruppo 1 (Equatoriale Z=0, R_c1 = 37 mm, asse Z)
Body Force 1
  Current Density 3 = Variable Coordinate 1, Coordinate 2, Coordinate 3, time
    Real MATC "group1_z_chirped_pulse_current(tx)"
End

! Body Force 2: Gruppo 2 (Meridiano X=0, R_c2 = 31 mm, asse X)
Body Force 2
  Current Density 1 = Variable Coordinate 1, Coordinate 2, Coordinate 3, time
    Real MATC "group2_x_chirped_pulse_current(tx)"
End

! Body 1: Mantello Sferico
Body 1
  Target Bodies(1) = 1
  Name = "MantelloSferico"
  Equation = 1
  Material = 1
End

! Body 2: Coils Gruppo 1 (Z)
Body 2
  Target Bodies(1) = 2
  Name = "CoilsGruppo1_Z"
  Equation = 1
  Material = 2
  Body Force = 1
End

! Body 3: Coils Gruppo 2 (X)
Body 3
  Target Bodies(1) = 3
  Name = "CoilsGruppo2_X"
  Equation = 1
  Material = 2
  Body Force = 2
End

! Body 4: Rotore PEEK Core
Body 4
  Target Bodies(1) = 4
  Name = "RotorePEEKCore"
  Equation = 1
  Material = 3
End

! Body 5: Cavita Aria Interna
Body 5
  Target Bodies(1) = 5
  Name = "CavitaAriaInterna"
  Equation = 1
  Material = 4
End

! Body 6: Aria Esterna
Body 6
  Target Bodies(1) = 6
  Name = "AriaEsterna"
  Equation = 1
  Material = 4
End

! Boundary Condition 1: Far-Field all'Infinito
Boundary Condition 1
  Target Boundaries(1) = 1
  Name = "FarField"
  AV {e} = Real 0.0
  AV = Real 0.0
End
